FROM rocker/r-ver:4

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libssl-dev \
       libsasl2-dev \
       libcurl4-openssl-dev \
       libicu-dev \
    && rm -rf /var/lib/apt/lists/*

RUN install2.r \
    --error \
    --skipinstalled \
    --ncpus -1 \
    DT \
    dplyr \
    ggplot2 \
    lubridate \
    mongolite \
    plotly \
    scales \
    shiny \
    stringr \
    tidyr \
    && rm -rf /tmp/downloaded_packages

WORKDIR /app
COPY app/app.R /app/app.R
COPY script_r/modules /script_r/modules
COPY output/pourcentage_valeurs_manquantes.png /app/www/output/pourcentage_valeurs_manquantes.png

EXPOSE 3838
HEALTHCHECK CMD Rscript -e "x <- url('http://127.0.0.1:3838'); open(x); close(x)" || exit 1

CMD ["R", "-e", "shiny::runApp('/app', host='0.0.0.0', port=3838, launch.browser=FALSE)"]

